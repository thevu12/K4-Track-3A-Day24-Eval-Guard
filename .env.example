# Required
OPENAI_API_KEY=
GEMINI_API_KEY=
# LLM_PROVIDER=openai  # or gemini

# Optional: HuggingFace token (only if using HF Inference Endpoints)
HF_TOKEN=

# Optional local model/runtime settings (never put secrets in this example).
# HF_HOME=.cache/huggingface
# TLDEXTRACT_CACHE=.cache/tldextract
# RAGAS_DO_NOT_TRACK=true
# EMBEDDING_DEVICE=cpu
# RERANK_DEVICE=cpu
# MODEL_BATCH_SIZE=16
# RERANK_MAX_LENGTH=1024
# QDRANT_HOST=localhost
# QDRANT_PORT=6333
# EVALUATOR_LLM_MODEL=gpt-4o-mini
# EVALUATOR_EMBEDDING_MODEL=text-embedding-3-small
# EVALUATOR_MAX_WORKERS=4
